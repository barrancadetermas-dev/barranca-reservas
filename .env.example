# MILA — Variables de entorno
# Copiá este archivo como .env.local y completá con tus datos

# Supabase — Obtenés estos valores en Supabase → Settings → API
VITE_SUPABASE_URL=https://tuproyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZAR

# Slug de tu hotel — Sin espacios, en minúsculas, con guiones
# Debe coincidir con el campo "slug" en la tabla hotels
VITE_HOTEL_SLUG=nombre-de-tu-complejo

# Demo (opcional) — Para la URL ?demo=true
VITE_DEMO_EMAIL=demo@milasistema.com
VITE_DEMO_PASS=DemoPass2025!
